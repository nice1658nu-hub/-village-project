<mxfile host="app.diagrams.net" modified="2026-10-16T00:00:00.000Z" agent="Codex" version="24.7.17">
  <diagram id="conceptual" name="กรอบแนวคิดในการพัฒนาระบบ">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root><mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="กรอบแนวคิดในการพัฒนาระบบ" style="text;html=1;fontSize=25;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="100" y="30" width="600" height="40" as="geometry"/></mxCell>
        <mxCell id="citizen" value="&lt;b&gt;ประชาชน&lt;/b&gt;&lt;br&gt;&lt;br&gt;ดูข่าวและแจ้งเหตุพร้อมรูปภาพ/พิกัด&lt;br&gt;ติดตามสถานะและร่วมยืนยันเหตุ&lt;br&gt;ให้คะแนน ความคิดเห็น หรือขอเปิดเรื่องใหม่" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;strokeWidth=2;fillColor=#f1f5ff;strokeColor=#334a9f;fontSize=15;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="120" width="390" height="175" as="geometry"/></mxCell>
        <mxCell id="village" value="&lt;b&gt;ผู้ดูแลหมู่บ้าน&lt;/b&gt;&lt;br&gt;&lt;br&gt;รับเรื่องและตรวจสอบหน้างาน&lt;br&gt;แนบหลักฐาน ส่งต่อ และตอบข้อมูลให้ อบต.&lt;br&gt;จัดการสมาชิก ข่าว และข้อเสนอโครงการ&lt;br&gt;ติดตามงานและดูรายงานหมู่บ้าน" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;strokeWidth=2;fillColor=#f1f5ff;strokeColor=#334a9f;fontSize=15;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="390" width="390" height="200" as="geometry"/></mxCell>
        <mxCell id="tao" value="&lt;b&gt;เจ้าหน้าที่ อบต.&lt;/b&gt;&lt;br&gt;&lt;br&gt;รับเรื่องและขอข้อมูลเพิ่มจากหมู่บ้าน&lt;br&gt;มอบหมาย กำหนดเวลา และปิดเรื่อง&lt;br&gt;บริหารงบประมาณ โครงการ และเนื้อหาส่วนกลาง&lt;br&gt;วิเคราะห์ข้อมูล ดูผลประเมิน และออกรายงาน" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;strokeWidth=2;fillColor=#f1f5ff;strokeColor=#334a9f;fontSize=15;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="690" width="390" height="200" as="geometry"/></mxCell>
        <mxCell id="system" value="&lt;b&gt;ระบบแจ้งเหตุ ติดตาม และวิเคราะห์&lt;br&gt;ปัญหาชุมชนอัจฉริยะ&lt;/b&gt;&lt;hr&gt;จัดการผู้ใช้และสิทธิ์ตามบทบาท&lt;br&gt;&lt;br&gt;รับเหตุ รูปภาพ พิกัด และป้องกันรายการซ้ำ&lt;br&gt;&lt;br&gt;ตรวจสอบ ส่งต่อ มอบหมาย และติดตามสถานะ&lt;br&gt;&lt;br&gt;บันทึกความคืบหน้า หลักฐาน และประวัติ&lt;br&gt;&lt;br&gt;จัดการงบประมาณและโครงการ&lt;br&gt;&lt;br&gt;ข่าว การแจ้งเตือน และผลประเมิน&lt;br&gt;&lt;br&gt;วิเคราะห์ข้อมูลและออกรายงาน Excel/PDF" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;strokeWidth=2;fillColor=#fff9e8;strokeColor=#a86b08;fontSize=15;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="600" y="235" width="480" height="510" as="geometry"/></mxCell>
        <mxCell id="database" value="&lt;b&gt;ฐานข้อมูล MySQL&lt;/b&gt;&lt;br&gt;&lt;br&gt;ผู้ใช้และหมู่บ้าน&lt;br&gt;เหตุแจ้ง ประวัติ และความคืบหน้า&lt;br&gt;งบประมาณและโครงการ&lt;br&gt;ข่าว การแจ้งเตือน และคะแนนประเมิน&lt;br&gt;ข้อมูลสนับสนุนและ Audit Log" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;strokeWidth=2;fillColor=#effcf4;strokeColor=#137333;fontSize=15;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1220" y="145" width="300" height="285" as="geometry"/></mxCell>
        <mxCell id="services" value="&lt;b&gt;บริการที่เชื่อมต่อ&lt;/b&gt;&lt;br&gt;&lt;br&gt;Leaflet / OpenStreetMap&lt;br&gt;Firebase Cloud Messaging&lt;br&gt;บริการอีเมลกู้รหัสผ่าน&lt;br&gt;พื้นที่จัดเก็บรูปภาพและหลักฐาน&lt;br&gt;ส่งออกไฟล์ Excel และ PDF" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;strokeWidth=2;fillColor=#faf2ff;strokeColor=#6f2da8;fontSize=15;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1220" y="560" width="300" height="285" as="geometry"/></mxCell>
        <mxCell id="e1" value="รับและแสดงข้อมูล" edge="1" parent="1" source="citizen" target="system" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=13;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="จัดการเหตุ" edge="1" parent="1" source="village" target="system" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=13;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="บริหารและวิเคราะห์" edge="1" parent="1" source="tao" target="system" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=13;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="จัดเก็บและเรียกข้อมูล" edge="1" parent="1" source="system" target="database" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=13;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="เชื่อมต่อ" edge="1" parent="1" source="system" target="services" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=13;"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
